LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Alternativa OpenRouter con el SDK OpenAI:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openrouter/free
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Para Anthropic: LLM_PROVIDER=anthropic y el ID de un modelo habilitado en tu cuenta.
LLM_TIMEOUT=90
LLM_RETRIES=1
